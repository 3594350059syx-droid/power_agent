# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=power_agent
DB_USER=postgres
# 与 deployment/docker-compose.yml 的 POSTGRES_PASSWORD 保持一致（复制 .env.example → .env 后可直接运行）
DB_PASSWORD=power_agent_password

# API
API_HOST=0.0.0.0
API_PORT=8000

# Agent (DeepSeek)
# 登录 https://platform.deepseek.com/api_keys 创建 API Key
DEEPSEEK_API_KEY=sk-你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat